{
  "name": "emotionfix",
  "version": "1.0.0",
  "private": true,
  "description": "E Motion Works Oy — business dashboard, POS, invoicing and bookkeeping system",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @emotionfix/api --filter @emotionfix/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @emotionfix/api db:migrate",
    "db:deploy": "pnpm --filter @emotionfix/api db:deploy",
    "db:seed": "pnpm --filter @emotionfix/api db:seed",
    "seed:demo": "pnpm --filter @emotionfix/api seed:demo",
    "import:excel": "pnpm --filter @emotionfix/api import:excel",
    "e2e": "pnpm --filter @emotionfix/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
