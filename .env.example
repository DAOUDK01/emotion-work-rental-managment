# ============================================================
# E Motion Works — environment variables
# Copy to apps/api/.env (API) and fill in real values.
# The web app needs no secrets; it proxies /api to the API.
# ============================================================

# --- Database (PostgreSQL 16) ---
# Pooled URL used by the app at runtime:
DATABASE_URL="postgresql://emotionfix:emotionfix@localhost:5432/emotionfix?schema=public"
# Direct (non-pooled) URL used by prisma migrate (same as DATABASE_URL when not using a pooler):
DIRECT_URL="postgresql://emotionfix:emotionfix@localhost:5432/emotionfix?schema=public"

# --- API server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS allow-list):
CORS_ORIGINS=http://localhost:5173
# Secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (minutes) and refresh token lifetime (days):
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Set to "true" behind HTTPS in production (marks cookies Secure):
COOKIE_SECURE=false
# Directory for uploaded files (receipts, agreements, photos):
UPLOAD_DIR=./uploads

# --- Initial admin accounts (used by `pnpm db:seed` on an empty database) ---
SEED_ADMIN_PASSWORD=ChangeMe!123

# --- WhatsApp Business Cloud API (official Meta API) ---
# Leave empty to disable the integration. See docs/WHATSAPP_META_COMPLIANCE.md.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Google Sheets sync (service account) ---
# Path to the service-account JSON key file, or leave empty to disable:
GOOGLE_SERVICE_ACCOUNT_FILE=
# The spreadsheet ID to mirror data into (share the sheet with the service account email):
GOOGLE_SHEET_ID=

# --- Email (SMTP) for sending invoices; leave host empty to use the outbox only ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E Motion Works Oy <billing@example.com>"

# --- Web app (apps/web/.env, optional) ---
# VITE_API_URL=http://localhost:4000
